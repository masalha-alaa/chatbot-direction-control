{
  "manifest_version": 3,
  "name": "ChatGPT Direction Control",
  "version": "1.0.0",
  "description": "Adds per-message LTR/RTL controls and composer direction shortcuts to ChatGPT and Gemini.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "site-adapters.js",
        "composer-direction.js",
        "response-direction.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
