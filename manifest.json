{
  "manifest_version": 3,
  "name": "Chatbot Direction Control",
  "version": "1.0.3",
  "description": "Adds per-message LTR/RTL controls and composer direction shortcuts to ChatGPT, Gemini, Claude, and Grok.",
  "icons": {
    "16": "assets/icon-16x16.png",
    "32": "assets/icon-32x32.png",
    "48": "assets/icon-48x48.png",
    "128": "assets/icon-128x128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://grok.com/*"
      ],
      "js": [
        "site-adapter-registry.js",
        "adapters/chatgpt.js",
        "adapters/gemini.js",
        "adapters/claude.js",
        "adapters/grok.js",
        "composer-direction.js",
        "response-direction.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
